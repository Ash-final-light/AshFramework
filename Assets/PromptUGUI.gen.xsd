        </xs:simpleType>
      </xs:attribute>
      <xs:anyAttribute processContents="lax" />
    </xs:complexType>
    <xs:unique name="screenIdUnique">
      <xs:selector xpath=".//*" />
      <xs:field xpath="@id" />
    </xs:unique>
  </xs:element>
  <xs:element name="Style">
    <xs:complexType>
      <xs:attribute name="name" use="required" type="xs:string" />
      <xs:anyAttribute processContents="lax" />
    </xs:complexType>
  </xs:element>
